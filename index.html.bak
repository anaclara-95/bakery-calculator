      <!---------------------------------------------------------------VISIT-------------------------------------------------------->

      <section class="visit section" id="visit">
        <div class="visit__container">
          <img src="./assets/visit-bg.jpg" alt="image" class="visit__bg" />
          <div class="visit__shadow"></div>
          <div class="visit__content container grid">
            <div class="visit__data">
              <h2 class="section__title" data-i18n="visit_title">Visit Us</h2>

              <p class="visit__description" data-i18n="visit_desc">
                Discover the best bread, we look forward to your visit.
              </p>

              <a href="#" class="button" data-i18n="visit_btn">See Location</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <!--------------------------------------------------------FOOTER----------------------------------------------------------->

    <footer class="footer">
      <div class="footer__container container grid">
        <div>
        <!--*Add img logo backery  -->
          <a href="#" class="footer__logo">Bakery</a>
          <p class="footer__description" data-i18n="footer_desc">
            We make the best bread <br />
            in the city.
          </p>
        </div>
        <div class="footer__content grid">
          <div>
            <h3 class="footer__title" data-i18n="footer_addr">Address</h3>

            <ul class="footer__list">
              <li>
                <address class="footer__info">
                  Av. 12323 <br />
                  Santa Fe Argentina
                </address>
              </li>

              <li>
                <address class="footer__info">9AM - 11PM</address>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="footer__title" data-i18n="footer_contact">Contact Me</h3>

            <ul class="footer__list">
              <li>
                <adress class="footer__info">bakery@email.com</adress>
              </li>

              <li>
                <adress class="footer__info">+00 987 654 321</adress>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="footer__title" data-i18n="footer_follow">Follow Us</h3>
            <div class="footer__social">
              <a href=" https://www.facebook.com/" target="__blank">
                <i class="ri-facebook-box-fill"></i>
              </a>

              <a href="https://www.instagram.com/" target="__blank">
                <i class="ri-instagram-line"></i>
              </a>

              <a href="https://www.youtube.com/" target="__blank">
                <i class="ri-youtube-line"></i>
              </a>
            </div>
          </div>
        </div>

        <img src="./assets/bread-4.png" alt="image" class="footer__img-1" />
        <img src="./assets/bread-3.png" alt="image" class="footer__img-2" />
      </div>
      <span class="footer__copy">
        &#169; All Rights Reserved By FsTailSolutions
      </span>
    </footer>

    <!----------------------------------------------------------------SCROLL UP-------------------------------------------------------------------------------->

    <a href="" class="scrollup" id="scroll-up">
      <i class="ri-arrow-up-line"></i>
    </a>

  </body>

  <script src="./js/lang.js"></script>
  <script src="./js/scrollreveal.min.js"></script>
  <script src="./js/main.js"></script>
</html>
